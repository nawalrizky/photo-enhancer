<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/ink">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:paddingStart="24dp"
        android:paddingTop="18dp"
        android:paddingEnd="24dp"
        android:paddingBottom="18dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="ENHANCER / DEVICE LAB"
            android:textColor="@color/paper"
            android:textSize="22sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/modelState"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="@color/panel"
            android:paddingHorizontal="12dp"
            android:paddingVertical="6dp"
            android:text="MODEL: CHECKING"
            android:textColor="@color/acid"
            android:textSize="11sp"
            android:textStyle="bold" />
    </LinearLayout>

    <TextView
        android:id="@+id/statusText"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:text="Select a portrait to begin. Processing stays on this device."
        android:textColor="@color/muted"
        android:textSize="13sp" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginTop="14dp"
        android:layout_weight="1"
        android:orientation="horizontal">

        <FrameLayout
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_marginEnd="6dp"
            android:layout_weight="1"
            android:background="@drawable/image_panel">

            <ImageView
                android:id="@+id/sourceImage"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:contentDescription="Source image"
                android:padding="8dp"
                android:scaleType="fitCenter" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="start|top"
                android:background="#CC10100F"
                android:paddingHorizontal="9dp"
                android:paddingVertical="5dp"
                android:text="SOURCE"
                android:textColor="@color/paper"
                android:textSize="10sp"
                android:textStyle="bold" />
        </FrameLayout>

        <FrameLayout
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_marginStart="6dp"
            android:layout_weight="1"
            android:background="@drawable/image_panel">

            <ImageView
                android:id="@+id/resultImage"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:contentDescription="Enhanced image"
                android:padding="8dp"
                android:scaleType="fitCenter" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="start|top"
                android:background="#CC10100F"
                android:paddingHorizontal="9dp"
                android:paddingVertical="5dp"
                android:text="RESULT"
                android:textColor="@color/acid"
                android:textSize="10sp"
                android:textStyle="bold" />

        </FrameLayout>
    </LinearLayout>

    <HorizontalScrollView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="14dp"
        android:fillViewport="true"
        android:scrollbars="none">

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <Button
                android:id="@+id/selectButton"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="@drawable/button_primary"
                android:text="SELECT PHOTO"
                android:textColor="@color/ink"
                android:textSize="12sp"
                android:textStyle="bold" />

            <Button
                android:id="@+id/cameraButton"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="10dp"
                android:background="@drawable/button_secondary"
                android:text="TAKE PHOTO"
                android:textColor="@color/paper"
                android:textSize="12sp"
                android:textStyle="bold" />

            <Button
                android:id="@+id/cropButton"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="10dp"
                android:background="@drawable/button_secondary"
                android:enabled="false"
                android:text="ENHANCE CROP"
                android:textColor="@color/paper"
                android:textSize="12sp"
                android:textStyle="bold" />

            <Button
                android:id="@+id/fullButton"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="10dp"
                android:background="@drawable/button_secondary"
                android:enabled="false"
                android:text="ENHANCE FULL"
                android:textColor="@color/paper"
                android:textSize="12sp"
                android:textStyle="bold" />

            <Button
                android:id="@+id/saveButton"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="10dp"
                android:background="@drawable/button_secondary"
                android:enabled="false"
                android:text="SAVE RESULT"
                android:textColor="@color/paper"
                android:textSize="12sp"
                android:textStyle="bold" />

            <Switch
                android:id="@+id/nnapiSwitch"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="18dp"
                android:checked="false"
                android:text="TRY NNAPI"
                android:textColor="@color/paper"
                android:textSize="11sp" />
        </LinearLayout>
    </HorizontalScrollView>
    </LinearLayout>

    <LinearLayout
        android:id="@+id/busyOverlay"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="#E610100F"
        android:clickable="true"
        android:elevation="12dp"
        android:focusable="true"
        android:gravity="center"
        android:orientation="vertical"
        android:visibility="gone">

        <ProgressBar
            style="?android:attr/progressBarStyleLarge"
            android:layout_width="56dp"
            android:layout_height="56dp"
            android:indeterminateTint="@color/acid" />

        <TextView
            android:id="@+id/progressMessage"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="18dp"
            android:textColor="@color/paper"
            android:textSize="16sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/progressElapsed"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:text="0s elapsed"
            android:textColor="@color/acid"
            android:textSize="13sp" />
    </LinearLayout>
</FrameLayout>
